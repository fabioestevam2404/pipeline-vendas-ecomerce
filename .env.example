# Copie para .env e preencha com valores reais. NUNCA versione o .env.

POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=
POSTGRES_DB=vendas_ecommerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Diretório local onde os CSVs do Olist (baixados do Kaggle) ficam antes do particionamento
RAW_DATA_DIR=./data/raw

# Diretório da landing zone (arquivos particionados por dia simulado)
LANDING_ZONE_DIR=./data/landing

# Diretório de quarentena (registros rejeitados)
QUARANTINE_DIR=./data/quarantine

# Airflow (ADR-001)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_PORT=8080
